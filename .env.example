# Copy this file to ".env" and fill in your local MySQL credentials.
# The app will refuse to talk to the database until this is done.

# --- MySQL connection ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cspc_reservation

# --- Express server ---
PORT=3000

# --- Session ---
# Change this to any long random string before deploying.
# Sessions are stored server-side in the MySQL "sessions" table; the browser
# only holds the HttpOnly "cspc.sid" cookie, so users stay signed in across
# page refreshes AND server restarts.
SESSION_SECRET=cspc-reservation-portal-dev-secret
# Set to 1 when running behind a reverse proxy / load balancer that terminates
# TLS (lets express read X-Forwarded-Proto so the session cookie gets its
# Secure flag in production). Leave unset on plain http://localhost.
# TRUST_PROXY=1

# --- Admin self-enrollment ---
# Shared secret required by POST /api/auth/register-admin (the "Create an
# admin account" flow on the homepage). Leave empty to disable it.
ADMIN_ENROLLMENT_CODE=CSPC-ADMIN-2026

# --- Seeded accounts (npm run init-db) ---
# Passwords for the seeded accounts (admin + demo) are NOT hardcoded in the
# code. Leave these empty and init-db generates a strong random password and
# prints it once at seed time. Set a value here to choose your own, then
# re-run `npm run init-db` to save it (only the bcrypt hash goes in the DB).
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# --- Google OAuth ("Sign in with CSPC Google Account") ---
# Create an OAuth 2.0 Client ID in Google Cloud Console
# (APIs & Services > Credentials > Create credentials > OAuth client ID,
# application type "Web application") and add this exact authorised
# redirect URI (scheme and port must match how you run the portal):
#   http://localhost:3000/api/auth/google/callback
# Leave both values empty to keep the button in its friendly
# "Google sign-in is not configured yet" state.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated email domains allowed to sign in with Google.
GOOGLE_ALLOWED_DOMAINS=cspc.edu.ph

# --- Outbound email (password recovery OTPs, see mailer.js) ---
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account -> Security -> App passwords) and paste it below.
# EMAIL_USER / EMAIL_PASS are accepted as aliases for SMTP_USER / SMTP_PASS.
# When neither pair is set the server prints the OTP to its console
# instead, and the frontend shows a "no email was sent" warning, so the
# "Forgot password?" flow still works during development without any
# email credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional "From" header; defaults to "CSPC Reservation Portal" <SMTP_USER>.
MAIL_FROM=
